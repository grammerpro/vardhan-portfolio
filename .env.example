# Copy this file to .env.local for local development.
# Keep all values server-side. Do not add NEXT_PUBLIC_ prefixes or commit secrets.
# The portfolio and direct email link work without provider configuration.

# Required for POST /api/contact: Resend API credential.
RESEND_API_KEY=

# Required for POST /api/contact: owner-controlled destination mailbox.
CONTACT_TO_EMAIL=

# Optional: a sender address verified for the existing Resend account.
# If omitted, the route retains its Resend onboarding sender, subject to account restrictions.
CONTACT_FROM_EMAIL=

# Required for POST /api/fit: existing Google Gemini API credential.
# Submitted role text is sent to Gemini for query embedding and assessment generation.
# Also used ONLY when deliberately running scripts/build-corpus.mjs after content approval.
GEMINI_API_KEY=
